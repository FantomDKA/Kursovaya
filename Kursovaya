/**
 * @class HedgeTester
 * @brief Класс для тестирования функционала калькулятора
 */
class HedgeTester {
private:
    vector<pair<string, bool>> testResults; ///< Результаты тестов

public:
    /**
     * @brief Выполняет все тесты
     */
    void runAllTests() {
        cout << "\n========== ТЕСТИРОВАНИЕ ПРОГРАММЫ ==========" << endl;
        
        testPositiveCases();
        testNegativeCases();
        testBoundaryCases();
        testPerformance();
        
        printTestSummary();
    }

private:
    /**
     * @brief Тестирует корректные случаи
     */
    void testPositiveCases() {
        cout << "\n--- Тест 1: Корректные данные ---" << endl;
        
        try {
            HedgeParameters params1(1000000, 75.5, 76.0, 0.1, 50000);
            HedgeCalculator calc1(params1);
            
            double eff1 = calc1.calculateEfficiency();
            bool test1 = (eff1 > 0 && eff1 <= 100);
            
            recordTest("Корректные данные (Пример 1)", test1);
            
            HedgeParameters params2(500000, 90.2, 89.8, 0.08, 15000);
            HedgeCalculator calc2(params2);
            
            double eff2 = calc2.calculateEfficiency();
            bool test2 = (eff2 > 0 && eff2 <= 100);
            
            recordTest("Корректные данные (Пример 2)", test2);
            
        } catch (const exception& e) {
            recordTest("Корректные данные", false);
            cout << "Ошибка: " << e.what() << endl;
        }
    }

    /**
     * @brief Тестирует некорректные случаи
     */
    void testNegativeCases() {
        cout << "\n--- Тест 2: Некорректные данные ---" << endl;
        
        vector<pair<string, HedgeParameters>> negativeTests = {
            {"Отрицательная сумма", HedgeParameters(-1000, 75.5, 76.0, 0.1, 50000)},
            {"Некорректная волатильность", HedgeParameters(1000000, 75.5, 76.0, 10, 50000)},
            {"Отрицательная стоимость", HedgeParameters(1000000, 75.5, 76.0, 0.1, -50000)}
        };
        
        for (const auto& test : negativeTests) {
            try {
                test.second.validate();
                recordTest(test.first, false);
                cout << "Тест не прошёл: " << test.first << endl;
            } catch (const invalid_argument&) {
                recordTest(test.first, true);
            }
        }
    }

    /**
     * @brief Тестирует граничные значения
     */
    void testBoundaryCases() {
        cout << "\n--- Тест 3: Граничные значения ---" << endl;
        
        try {
            // Минимальные значения
            HedgeParameters paramsMin(0.01, 0.0001, 0.0001, 0, 0);
            HedgeCalculator calcMin(paramsMin);
            
            bool testMin = (calcMin.calculateEfficiency() == 0);
            recordTest("Минимальные значения", testMin);
            
            // Максимальные значения
            HedgeParameters paramsMax(1e12, 1e6, 1e6, 5, 1e12);
            HedgeCalculator calcMax(paramsMax);
            
            bool testMax = (calcMax.calculateEfficiency() >= 0);
            recordTest("Максимальные значения", testMax);
            
        } catch (const exception& e) {
            recordTest("Граничные значения", false);
            cout << "Ошибка: " << e.what() << endl;
        }
    }

    /**
     * @brief Тестирует производительность
     */
    void testPerformance() {
        cout << "\n--- Тест 4: Производительность ---" << endl;
        
        try {
            clock_t start = clock();
            
            // Выполняем 10000 расчётов
            for (int i = 0; i < 10000; i++) {
                HedgeParameters params(1000000 + i, 75.5, 76.0, 0.1, 50000);
                HedgeCalculator calc(params);
                calc.calculateEfficiency();
            }
            
            clock_t end = clock();
            double duration = double(end - start) / CLOCKS_PER_SEC;
            
            bool performanceTest = (duration < 1.0); // Должно выполняться менее 1 секунды
            recordTest("Производительность (10000 итераций)", performanceTest);
            
            cout << "Время выполнения: " << duration << " секунд" << endl;
            
        } catch (const exception& e) {
            recordTest("Производительность", false);
            cout << "Ошибка: " << e.what() << endl;
        }
    }

    /**
     * @brief Записывает результат теста
     * @param testName Название теста
     * @param result Результат теста
     */
    void recordTest(const string& testName, bool result) {
        testResults.push_back({testName, result});
        cout << (result ? "✓ " : "✗ ") << testName << endl;
    }

    /**
     * @brief Выводит сводку по тестам
     */
    void printTestSummary() {
        int passed = count_if(testResults.begin(), testResults.end(),
                            [](const auto& test) { return test.second; });
        int total = testResults.size();
        
        cout << "\n========== ИТОГИ ТЕСТИРОВАНИЯ ==========" << endl;
        cout << "Всего тестов: " << total << endl;
        cout << "Пройдено: " << passed << endl;
        cout << "Не пройдено: " << (total - passed) << endl;
        cout << "Успешность: " << (passed * 100 / total) << "%" << endl;
        
        if (passed == total) {
            cout << "✓ ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!" << endl;
        } else {
            cout << "✗ ЕСТЬ ПРОБЛЕМЫ В РАБОТЕ ПРОГРАММЫ" << endl;
            
            // Выводим неудавшиеся тесты
            cout << "\nНеудавшиеся тесты:" << endl;
            for (const auto& test : testResults) {
                if (!test.second) {
                    cout << "  - " << test.first << endl;
                }
            }
        }
        cout << "========================================" << endl;
    }
};

