/**
 * @class HedgeParameters
 * @brief Класс для хранения параметров хеджирования
 */
class HedgeParameters {
private:
    double exportAmount;      ///< Сумма экспорта
    double currentRate;       ///< Текущий спот-курс
    double coefficientRate;   ///< Коэффициент курса
    double volatility;        ///< Годовая волатильность
    double hedgingCost;       ///< Стоимость хеджирования

public:
    // Конструктор с параметрами
    HedgeParameters(double expAmt, double currRate, double coeffRate, 
                   double vol, double hedgeCost) 
        : exportAmount(expAmt), currentRate(currRate), 
          coefficientRate(coeffRate), volatility(vol), 
          hedgingCost(hedgeCost) {}

    // Геттеры
    double getExportAmount() const { return exportAmount; }
    double getCurrentRate() const { return currentRate; }
    double getCoefficientRate() const { return coefficientRate; }
    double getVolatility() const { return volatility; }
    double getHedgingCost() const { return hedgingCost; }

    /**
     * @brief Проверяет корректность всех параметров
     * @return true если все параметры корректны
     * @throw invalid_argument если параметры некорректны
     */
    bool validate() const {
        if (!InputValidator::validateRange(exportAmount, 0.01, 1e12)) {
            throw invalid_argument("Сумма экспорта должна быть от 0.01 до 10^12");
        }
        
        if (!InputValidator::validateRange(currentRate, 0.0001, 1e6)) {
            throw invalid_argument("Текущий курс должен быть от 0.0001 до 10^6");
        }
        
        if (!InputValidator::validateRange(coefficientRate, 0.0001, 1e6)) {
            throw invalid_argument("Коэффициент курса должен быть от 0.0001 до 10^6");
        }
        
        if (!InputValidator::validateRange(volatility, 0, 5)) {
            throw invalid_argument("Волатильность должна быть от 0 до 5");
        }
        
        if (!InputValidator::validateRange(hedgingCost, 0, 1e12)) {
            throw invalid_argument("Стоимость хеджирования должна быть от 0 до 10^12");
        }
        
        return true;
    }
};

// ==================== КЛАСС ДЛЯ РАСЧЁТА РЕЗУЛЬТАТОВ ====================

/**
 * @class HedgeCalculator
 * @brief Класс для расчёта эффективности хеджирования
 */
class HedgeCalculator {
private:
    HedgeParameters params;   ///< Параметры расчёта

public:
    /**
     * @brief Конструктор класса
     * @param parameters Параметры для расчёта
     */
    HedgeCalculator(const HedgeParameters& parameters) 
        : params(parameters) {
        params.validate();
    }

    /**
     * @brief Рассчитывает потенциальные потери без хеджирования
     * @param z Квантиль нормального распределения (по умолчанию 1.96 для 95%)
     * @return Потенциальные потери
     */
    double calculatePotentialLoss(double z = 1.96) const {
        return params.getExportAmount() * params.getVolatility() * z;
    }

    /**
     * @brief Рассчитывает эффективность хеджирования
     * @return Эффективность в процентах (0-100)
     */
    double calculateEfficiency() const {
        double potentialLoss = calculatePotentialLoss();
        
        if (potentialLoss <= 0) {
            return 0.0;
        }
        
        double efficiency = (1 - params.getHedgingCost() / potentialLoss) * 100;
        
        // Ограничиваем диапазон 0-100%
        return max(0.0, min(100.0, efficiency));
    }

    /**
     * @brief Рассчитывает оптимальный объём хеджирования
     * @return Оптимальный объём в процентах (0-100)
     */
    double calculateOptimalVolume() const {
        double potentialLoss = calculatePotentialLoss();
        
        if (potentialLoss <= 0) {
            return 0.0;
        }
        
        // Упрощённая модель на основе коэффициента Шарпа
        double riskFreeRate = 0.03; // Безрисковая ставка 3%
        double riskPremium = potentialLoss - params.getHedgingCost();
        double risk = potentialLoss * 0.15; // Предполагаемое стандартное отклонение
        
        if (risk <= 0) {
            return 50.0; // Значение по умолчанию
        }
        
        double sharpeRatio = (riskPremium - riskFreeRate) / risk;
        double optimalVolume = 50.0 + (sharpeRatio * 25.0);
        
        // Ограничиваем диапазон 0-100%
        return max(0.0, min(100.0, optimalVolume));
    }

    /**
     * @brief Рассчитывает экономию от хеджирования
     * @return Экономия в денежных единицах
     */
    double calculateSavings() const {
        double potentialLoss = calculatePotentialLoss();
        double optimalVolume = calculateOptimalVolume();
        
        return potentialLoss * (optimalVolume / 100.0) - params.getHedgingCost();
    }

    /**
     * @brief Рассчитывает стоимость хеджирования
     * @return Стоимость хеджирования
     */
    double calculateHedgingCost() const {
        return params.getHedgingCost();
    }

    /**
     * @brief Выводит результаты расчёта в консоль
     */
    void printResults() const {
        double efficiency = calculateEfficiency();
        double savings = calculateSavings();
        double optimalVolume = calculateOptimalVolume();
        double hedgingCost = calculateHedgingCost();
        
        cout << fixed << setprecision(2);
        cout << "\n========== РЕЗУЛЬТАТЫ РАСЧЁТА ==========" << endl;
        cout << "Эффективность хеджирования: " << efficiency << "%" << endl;
        cout << "Экономия: " << savings << " руб." << endl;
        cout << "Оптимальный объём хеджирования: " << optimalVolume << "%" << endl;
        cout << "Стоимость хеджирования: " << hedgingCost << " руб." << endl;
        cout << "========================================" << endl;
    }
};

