/**
 * @class InputValidator
 * @brief Класс для проверки корректности входных данных
 */
class InputValidator {
public:
    /**
     * @brief Проверяет, находится ли значение в заданном диапазоне
     * @param value Проверяемое значение
     * @param min Минимальное допустимое значение
     * @param max Максимальное допустимое значение
     * @return true если значение корректно, false в противном случае
     */
    static bool validateRange(double value, double min, double max) {
        return (value >= min && value <= max);
    }

    /**
     * @brief Проверяет положительное значение
     * @param value Проверяемое значение
     * @return true если значение положительное
     */
    static bool validatePositive(double value) {
        return value > 0;
    }

    /**
     * @brief Проверяет корректность валютного значения
     * @param value Проверяемое значение
     * @return true если значение может быть валютным
     */
    static bool validateCurrency(double value) {
        return !isnan(value) && !isinf(value) && value >= 0;
    }
};

